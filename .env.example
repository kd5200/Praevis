# Praevis local environment
# Copy to .env and adjust as needed: cp .env.example .env

# Branding (replaceable codename)
APP_NAME=Praevis

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
LOG_JSON=true

# Database
POSTGRES_USER=praevis
POSTGRES_PASSWORD=praevis
POSTGRES_DB=praevis
POSTGRES_HOST=localhost
# Host port mapping (container always listens on 5432). Default 15432 avoids clashes with local Postgres.
POSTGRES_PORT=15432
DATABASE_URL=postgresql+psycopg://praevis:praevis@localhost:15432/praevis

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Web
NEXT_PUBLIC_APP_NAME=Praevis
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
WEB_PORT=3000

# Fetch / security (Phase 2+; documented early)
HTTP_TIMEOUT_CONNECT_SECONDS=5
HTTP_TIMEOUT_READ_SECONDS=10
HTTP_MAX_RESPONSE_BYTES=2097152
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT="PraevisSecurityGateway/0.1 (+https://example.local/praevis)"
